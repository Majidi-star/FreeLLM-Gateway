NODE_ENV=development
PORT=8787
DATABASE_PATH=./data/goalroute.db
# Required: 32-byte hex string (64 hex characters)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Required in production: admin token for /api/v1/*
ADMIN_API_TOKEN=dev-admin-secret-token-change-in-prod
LOG_LEVEL=info
DEFAULT_PROVIDER_TIMEOUT_MS=30000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_BASE_COOLDOWN_MS=30000
