{
  "name": "goalroute",
  "version": "0.1.0",
  "description": "Multi-provider LLM gateway with goal-based self-healing routing",
  "main": "dist/cli/index.js",
  "type": "module",
  "bin": {
    "goalroute": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:web": "tsc && vite build",
    "clean": "rimraf dist",
    "start": "node dist/api/server.js",
    "dev": "vite",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@tanstack/react-query": "^5.66.9",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "lucide-react": "^0.475.0",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ulid": "^2.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
